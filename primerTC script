evaluating phylogenetic coverage
```{r}
# cutadapt
for (primer in (names(primers))) {
  
  primer_name = primer
  primer_seq <- primers[primer_name]
  
  # filepaths
  input <- file.path(input_path)
  output <- file.path(out_path, paste0(primer_name, ".fasta")) #creating an output file for the result of the primer removal step. This will also automatically create a sub-folder for each of the barcode.
  info_file <- file.path(out_path, paste0(primer_name, ".tsv"))
  info_file2 <- file.path(out_path, paste0(primer_name, "_2.tsv"))
  
  
  # cutadapt
  system2(
    command = cutadapt,
    args = c(paste0("-b primer=", primer_seq, collapse = ""), #tell that the primer can be anywhere in the sequence
             "-e 0.2", #80% identity minimum
             "--revcomp", #looks also at the rev complement 
             paste0("--info-file=", info_file), #detail output
             "-o", output, #output
             sequence_path) #input
  )
  
  system2(
    command = "echo",
    args = c(
      "'Name\tError\tStart\tEnd\tLeft_Sequence\tMatch_Sequence\tRight_Sequence\tPrimer\t-\t-\t-\tRevComp'",
      "| cat -", info_file,
      ">",
      info_file2
    )
  )
  
  # clean-up cutadapt
  cutadapt_info <- read_tsv(info_file2) %>%
    select(Name, Primer, Error, Start, End,Left_Sequence, Match_Sequence, Right_Sequence, RevComp) %>%   #import file into dataframe and only keep the relevant column
    mutate(RAW_SEQ = paste0(Left_Sequence, Match_Sequence, Right_Sequence)) %>%
    mutate(RAW_SEQ = case_when(
      RAW_SEQ == "NANANA" ~ as.character(Start), TRUE ~ RAW_SEQ
    )
    )
  
  cutadapt_info$Match_Sequence[is.na(cutadapt_info$Match_Sequence)] <- "-"
  
  # pairwise alignment 
  pwa <- pwalign::pairwiseAlignment( 
    pattern = (cutadapt_info$Match_Sequence), 
    subject = primer_seq,  
    type    = "global"
  )
  
  # PWA summary
  pwa_summary <-
    tibble(
      SEQ_NAME         = cutadapt_info$Name,
      PRIMER           = primer_name,
      ALIGN_TYPE       = pwalign::type(pwa),      # alignment type
      ALIGN_SCORE      = pwalign::score(pwa),     # alignment score
      PERC_ID          = pwalign::pid(pwa),       # percent identity
      SEQ_LENGTH       = pwalign::nchar(pwa),     # ASV sequence length
      MATCH_COUNT      = pwalign::nmatch(pwa),    # total number of bases that matches reference sequence
      DIFF_COUNT       = pwalign::nedit(pwa),     # total number of bases that differs from reference sequence
      SUB_COUNT        = pwalign::nmismatch(pwa), # total number (bases) of substitution
      INS_COUNT        = pwalign::nindel(pwa)@insertion[, "Length"],   # total number of insertion fragment
      DEL_COUNT        = pwalign::nindel(pwa)@deletion[, "Length"],    # total number of deletion fragment
      INS_LENGTH_TOTAL = pwalign::nindel(pwa)@insertion[, "WidthSum"], # total length of insertion
      DEL_LENGTH_TOTAL = pwalign::nindel(pwa)@deletion[, "WidthSum"],  # total length of deletion
      ALIGNED_SEQ  = pwalign::aligned(pwa) %>% as.character(),      # aligned ASV sequence, insertion not shown
      RAW_SEQ = cutadapt_info$RAW_SEQ
    )
  final_summary[[primer_name]] <- pwa_summary
  
}

