building phylogenetic tree for primerTC visualization
```{r}
# install.packages("BiocManager")
# BiocManager::install(version = "3.19")
# install Biostrings and DECIPHER
# BiocManager::install("Biostrings")
# BiocManager::install("DECIPHER")

# generate consensus sequence for each genus in R
library("DECIPHER")
library("Biostrings")

# file path to the downloaded ref seqs
db_path <- "/Users/matthew/Desktop/JA-TEST/all_fasta_consensus-JA_TEST.fasta.fasta"

# file path to where you want to save the consensus sequence FASTA file
consensus_path <- "/Users/matthew/Desktop/JA-TEST/all_fasta_consensus.fasta"

# read in the ref seq database
db <- Biostrings::readDNAStringSet(db_path)

# extract genus names from the sequence names of the database
db_seq_names <- names(db)
# db_seq_genera <- vapply(strsplit(db_seq_names, ";"), `[`, 7, FUN.VALUE=character(1))
### below added my me
db_seq_genera <- sub(".*\\)_", "", db_seq_names)





# group each ref seq by its genus
db_seqs <- split(db, f = db_seq_genera)

# loop through each genus and create multiple sequence alignment (MSA)
# of all ref seqs within a genus and generate the consensus from the MSA
for (i in seq_along(db_seqs)) {
  genus_seqs <- db_seqs[[i]]
  genus_name <- names(db_seqs)[i]

  if (length(genus_seqs) > 1) {
    genus_msa <- DECIPHER::AlignSeqs(DECIPHER::RemoveGaps(genus_seqs))
    genus_consensus <-
      Biostrings::DNAMultipleAlignment(genus_msa) |>
      Biostrings::consensusString(ambiguityMap = Biostrings::IUPAC_CODE_MAP) |>
      Biostrings::DNAStringSet()
  } else {
    genus_consensus <- genus_seqs
  }

  names(genus_consensus) <- genus_name

  if (i == 1L) {
    consensus <- genus_consensus
  } else {
    consensus <-c(consensus, genus_consensus)
  }
}

Biostrings::writeXStringSet(consensus, consensus_path)
```

Generate alignment and tree from consensus sequences using MAFFT and RAxML-NG
##### NOTE: below done in the Terminal

# MAFFT aligner will be used for creating multiple sequence alignment (MSA) of the consensus sequences and RAxML-NG for building the tree. The easiest way to install both programs is to use conda by installing Miniconda. Instructions on how to install Miniconda is available here.
# once Miniconda is installed, run the below command in a terminal program to install MAFFT and RAxML-NG in a conda environment called primertc-tree:



conda create --name primertc-tree \
  --channel bioconda --channel conda-forge \
  mafft raxml-ng


# once the programs are installed, run the below commands to perform multiple sequence alignment of the consensus sequences and generate a maximum likelihood tree using MAFFT and RAxML-NG. This process may take a few minutes up to a few hours or days depending on the number, length, and complexity of the sequences.

# activate the conda environment containing MAFFT and RAxML-NG:
conda activate primertc-tree

# change working directory
cd /Users/matthew/Desktop/JA-TEST

# build alignment of consensus sequences:
mafft --thread 4 all_fasta_consensus-JA_TEST.fasta.fasta \
    > all_fasta_consensus_aligned.fasta

# build tree from aligned consensus sequences using GTR+G model (will take a while)
raxml-ng --threads 2 --model GTR+G \
  --msa all_fasta_consensus_aligned.fasta



