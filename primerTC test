#("PR_SEQ" = "TCGGAAGGAACCAGCTACTA") #D3B - internal-6
#("PR_SEQ" = "GTAGGTGAACCTGCGGAAGAATCATT") #NC5
#("PR_SEQ" = "AAATGGTAAAATTAATTAAGCTATCGCT") #Brug.ITS.f.260 - internal-1
#("PR_SEQ" = "AGCGGAGGAAAAGAAACTAA") #NC2 - internal-2-RC
#("PR_SEQ" = "GATTCCCTTAGTAACGGCGAGTGAAA") #V2R - internal-3-RC
#("PR_SEQ" = "CGAGTGTTTGGGTGGAA") #LR16 - internal-4-RC
#("PR_SEQ" = "GGAYMGGGAATTGHAATTRTTTCC") #Nem1619 - internal-5-RC
#("PR_SEQ" = "TAGTAGCTGGTTCCTTCCGA") #D3B - internal-6-RC
#("PR_SEQ" = "GACTAATCGAACCATCTAGTAGCTG") #28S-CL-R-RC - operon-rv-RC



# Load tree once (same for all)
Genus_Tree <- ape::read.tree(tree_path)

# Species of interest
species_of_interest <- c(
  "Strongyloides_ratti",
  "Trichuris_muris",
  "Ascaris_suum",
  "Brugia_pahangi",
  "Heligmosomoides_polygyrus",
  "Heligmosomoides_polygyrus_bakeri",
  "Heligmosomoides_polygyrus_polygyrus"
)

# Heatmap colours
color_primers <- c(
  "Primer PID < 70%" = "#CFECFF",
  "Primer 70-75%"    = "#B2CCF1",
  "Primer 75-80%"    = "#96ADE3",
  "Primer 80-85%"    = "#798DD5",
  "Primer 85-90%"    = "#5C6DC7",
  "Primer 90-95%"    = "#404EB9",
  "Primer 95-100%"   = "#232EAB",
  "Primer 100%"      = "#00FF74",
  "NA"               = "white"
)

# Load FASTA names once
db <- Biostrings::readDNAStringSet(sequence_path)
all_species_names <- unique(str_remove(names(db), " rc$"))

# --- LOOP OVER PRIMERS ---
for (p in primers) {
  
  primer_seq    <- p$seq
  primer_length <- nchar(primer_seq)
  info_file     <- file.path(out_path, p$info)
  
  message("Processing: ", p$name)
  
  # Read and parse cutadapt info
  lines <- readLines(info_file, warn = FALSE)
  
  cutadapt_rows <- lapply(lines, function(x) {
    fields <- strsplit(x, "\t", fixed = TRUE)[[1]]
    if (length(fields) >= 12 && fields[8] == "primer") {
      data.frame(
        Name           = fields[1],
        Error          = as.numeric(fields[2]),
        Match_Sequence = fields[6],
        stringsAsFactors = FALSE
      )
    } else {
      NULL
    }
  })
  
  cutadapt_matches <- bind_rows(cutadapt_rows) %>%
    mutate(Match_Ungapped = str_replace_all(Match_Sequence, "-", ""))
  
  # Match counting function
  calculate_matches <- function(sequence, primer) {
    n <- min(nchar(sequence), nchar(primer))
    sequence <- substr(sequence, 1, n)
    primer   <- substr(primer, 1, n)
    sum(strsplit(sequence, "", fixed = TRUE)[[1]] == strsplit(primer, "", fixed = TRUE)[[1]])
  }
  
  # Calculate binding
  cutadapt_matches <- cutadapt_matches %>%
    rowwise() %>%
    mutate(
      MATCH_COUNT = calculate_matches(Match_Ungapped, primer_seq),
      PMP         = (MATCH_COUNT / primer_length) * 100
    ) %>%
    ungroup() %>%
    mutate(
      genus = str_remove(Name, " rc$"),
      Primer_Category = case_when(
        PMP < 70          ~ "Primer PID < 70%",
        PMP >= 70 & PMP < 75 ~ "Primer 70-75%",
        PMP >= 75 & PMP < 80 ~ "Primer 75-80%",
        PMP >= 80 & PMP < 85 ~ "Primer 80-85%",
        PMP >= 85 & PMP < 90 ~ "Primer 85-90%",
        PMP >= 90 & PMP < 95 ~ "Primer 90-95%",
        PMP >= 95 & PMP < 100 ~ "Primer 95-100%",
        PMP == 100        ~ "Primer 100%",
        TRUE              ~ "NA"
      )
    )
  
  # Save binding results
  write_xlsx(cutadapt_matches, file.path(out_path, paste0(p$name, "_primer_binding.xlsx")))
  
  # Print species of interest
  print(
    cutadapt_matches %>%
      filter(genus %in% species_of_interest) %>%
      select(genus, Match_Sequence, Match_Ungapped, MATCH_COUNT, PMP, Primer_Category)
  )
  
  # Build final table (including no-match species)
  all_species <- cutadapt_matches %>%
    select(genus, PMP, Primer_Category) %>%
    distinct()
  
  final <- data.frame(genus = all_species_names, stringsAsFactors = FALSE) %>%
    left_join(all_species, by = "genus") %>%
    mutate(Primer_Category = ifelse(is.na(PMP), "NA", Primer_Category))
  
  write_xlsx(final, file.path(out_path, paste0(p$name, "_FINAL.xlsx")))
  
  # Check the six species
  print(
    final %>%
      filter(genus %in% species_of_interest) %>%
      select(genus, PMP, Primer_Category)
  )
  
  # Make heatmap matrix
  heatmap_data <- final %>%
    select(genus, Primer_Category) %>%
    distinct() %>%
    rename(Primer = Primer_Category)
  
  heatmap_matrix <- as.data.frame(column_to_rownames(heatmap_data, "genus"))
  heatmap_matrix$Primer <- factor(heatmap_matrix$Primer, levels = names(color_primers))
  
  # Plot tree
  Plot_Genus_Tree <- ggtree(Genus_Tree, layout = "circular", branch.length = "none") +
    geom_tiplab(align = TRUE, linesize = 0.5, vjust = 0.5, hjust = -0.2, offset = 0)
  
  final_tree <- gheatmap(
    Plot_Genus_Tree,
    heatmap_matrix,
    offset     = 8,
    width      = 0.25,
    colnames   = FALSE,
    color      = NA
  ) +
    scale_fill_manual(values = color_primers, drop = FALSE, na.value = "white") +
    labs(fill = "Primer binding")
  
  # Save images
  ggsave(file.path(image_path, paste0(p$name, "_CORRECTED.png")), final_tree, width = 40, height = 60, limitsize = FALSE)
  ggsave(file.path(image_path, paste0(p$name, "_CORRECTED.pdf")), final_tree, width = 40, height = 60, limitsize = FALSE)
  
  print(final_tree)
}
