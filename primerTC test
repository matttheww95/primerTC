  ),
  list(
    name = "internal_2",
    seq = "TTAGTTTCTTTTCCTCCGCT",
    info = "PR_SEQ.tsv"
  ),
  list(
    name = "internal_3",
    seq = "TTTCACTCGCCGTTACTAAGGGAATC",
    info = "PR_SEQ.tsv"
  ),
  list(
    name = "internal_4",
    seq = "TTCCACCCAAACACTCG",
    info = "PR_SEQ.tsv"
  ),
  list(
    name = "internal_5",
    seq = "GGAAAYAATTDCAATTCCCKRTCC",
    info = "PR_SEQ.tsv"
  ),
  list(
    name = "internal_6",
    seq = "TCGGAAGGAACCAGCTACTA",
    info = "PR_SEQ.tsv"
  )
)

