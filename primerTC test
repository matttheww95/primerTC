library(dplyr)
library(stringr)
library(readxl)
library(writexl)
library(ggplot2)
library(ggtree)
library(ape)
library(Biostrings)

# Paths
out_path      <- "/Users/matthew/Desktop/JA-TEST"
image_path    <- "/Users/matthew/Desktop/JA-TEST/images_test"
sequence_path <- "/Users/matthew/Desktop/JA-TEST/all_fasta_consensus.fasta"
tree_path     <- "/Users/matthew/Desktop/JA-TEST/all_fasta_consensus_aligned.fasta.raxml.bestTree"

# --- DEFINE YOUR PRIMERS HERE ---
primers <- list(
  list(
    name = "operon_rv",
    seq  = "CAGCTACTAGATGGTTCGATTAGTC",
    info = "PR_SEQ.tsv"   # your cutadapt info filename for this primer
  ),
  list(
    name = "operon_fw",
    seq  = "CTTGTCTCAAAGATTAAGCCATGCAT",
    info = "PR_SEQ.tsv"
  ),
  list(
